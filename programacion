def mostrar_registro():
    limpiar_cuerpo()
    tk.Label(crear_cuerpo, text="Crear Cuenta de Cliente", font=("Helvetica", 20, "bold"), bg="white", fg="#111111").pack(pady=15)
    
    tk.Label(crear_cuerpo, text="Nombre Completo:", bg="white", font=("Helvetica", 10)).pack()
    nombre_e = tk.Entry(crear_cuerpo, font=("Helvetica", 11), width=30)
    nombre_e.pack(pady=5)

    tk.Label(crear_cuerpo, text="Correo Electrónico:", bg="white", font=("Helvetica", 10)).pack()
    correo_e = tk.Entry(crear_cuerpo, font=("Helvetica", 11), width=30)
    correo_e.pack(pady=5)

    tk.Label(crear_cuerpo, text="Contraseña:", bg="white", font=("Helvetica", 10)).pack()
    pass_e = tk.Entry(crear_cuerpo, show="*", font=("Helvetica", 11), width=30)
    pass_e.pack(pady=5)

    def registrar():
        nombre = nombre_e.get().strip()
        correo = correo_e.get().strip()
        contra = pass_e.get().strip()
        if not (nombre and correo and contra):
            messagebox.showerror("Error", "Complete todos los campos para registrarse")
            return
        if correo == usuario_predeterminado["correo"]:
            messagebox.showerror("Error", "Ya existe un usuario con ese correo")
            return
        for u in usuarios_registrados:
            if u["correo"] == correo:
                messagebox.showerror("Error", "Ya existe un usuario con ese correo")
                return
        nuevo = {
            "nombre": nombre, "correo": correo, "contrasena": contra,
            "tarjeta": None, "mi_lista": [], "historial": []
        }
        usuarios_registrados.append(nuevo)
        messagebox.showinfo("Registro Exitoso", "¡Tu cuenta ha sido creada correctamente!")
        ejecutar_login(prefill_email=correo, prefill_pass=contra) # Manda al login directamente relleno

    tk.Button(crear_cuerpo, text="Registrarse", font=("Helvetica", 11, "bold"), bg="#FF9500", fg="black", bd=0, padx=30, pady=6, command=registrar, cursor="hand2").pack(pady=15)
    
    tk.Button(crear_cuerpo, text="¿Ya tienes cuenta? Inicia sesión", font=("Helvetica", 10, "underline"), bg="white", fg="gray", bd=0, command=ejecutar_login, cursor="hand2").pack(pady=5)

def cerrar_sesion():
