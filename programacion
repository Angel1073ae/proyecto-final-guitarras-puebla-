        tk.Button(frame, text="🔒 Agregar a Mi Lista", bg="#E5E5EA", fg="black", bd=0, font=("Helvetica", 10), padx=10, pady=5, command=lambda prod=p: agregar_mi_lista(prod), cursor="hand2").pack(side="right", padx=5)
        tk.Button(frame, text="🛒 Añadir al Carrito", bg="#FF9500", fg="black", bd=0, font=("Helvetica", 10, "bold"), padx=12, pady=5, command=lambda prod=p: agregar_carrito(prod), cursor="hand2").pack(side="right", padx=5)

