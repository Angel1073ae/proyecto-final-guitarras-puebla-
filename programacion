# VISTA DE LOGIN INTEGRADA
def ejecutar_login(prefill_email="", prefill_pass=""):
    limpiar_cuerpo()
    tk.Label(crear_cuerpo, text="Iniciar Sesión", font=("Helvetica", 20, "bold"), bg="white", fg="#111111").pack(pady=15)

    tk.Label(crear_cuerpo, text="Correo Electrónico:", bg="white", font=("Helvetica", 10)).pack()
    usuario_entry = tk.Entry(crear_cuerpo, font=("Helvetica", 11), width=30)
    usuario_entry.pack(pady=5)
    usuario_entry.insert(0, prefill_email)

    tk.Label(crear_cuerpo, text="Contraseña:", bg="white", font=("Helvetica", 10)).pack()
    pass_entry = tk.Entry(crear_cuerpo, show="*", font=("Helvetica", 11), width=30)
    pass_entry.pack(pady=5)
    pass_entry.insert(0, prefill_pass)

    def validar_login():
        global activar_login, current_user
        correo = usuario_entry.get().strip()
        contra = pass_entry.get().strip()
        if correo and contra:
            # Primero checar en los usuarios registrados de la ejecución actual
            for u in usuarios_registrados:
                if u["correo"] == correo and u["contrasena"] == contra:
                    activar_login = True
                    current_user = u
                    messagebox.showinfo("Bienvenido", f"Sesión iniciada como {u['nombre']}")
                    mostrar_inicio()
                    return
            if correo == usuario_predeterminado["correo"] and contra == usuario_predeterminado["contrasena"]:
                activar_login = True
                current_user = usuario_predeterminado
                messagebox.showinfo("Bienvenido", f"Sesión iniciada como {usuario_predeterminado['nombre']}")
                mostrar_inicio()
                return
            messagebox.showerror("Error", "Usuario o contraseña incorrectos")
        else:
            messagebox.showerror("Error", "Ingrese usuario y contraseña")

    tk.Button(crear_cuerpo, text="Entrar", font=("Helvetica", 11, "bold"), bg="#111111", fg="white", bd=0, padx=40, pady=6, command=validar_login, cursor="hand2").pack(pady=15)

    # Botón/Enlace integrado de Registro abajo del botón Entrar
    tk.Label(crear_cuerpo, text="¿No tienes una cuenta aún?", bg="white", fg="gray", font=("Helvetica", 10)).pack(pady=(10, 0))
    tk.Button(crear_cuerpo, text="Regístrate aquí", font=("Helvetica", 10, "underline"), bg="white", fg="#FF9500", bd=0, command=mostrar_registro, cursor="hand2").pack()

    def usar_demo():
        global activar_login, current_user
        activar_login = True
        current_user = {
            "nombre": usuario_predeterminado["nombre"], "correo": usuario_predeterminado["correo"],
            "contrasena": usuario_predeterminado["contrasena"], "tarjeta": usuario_predeterminado["tarjeta"],
            "mi_lista": list(usuario_predeterminado["mi_lista"]), "historial": list(usuario_predeterminado["historial"])
        }
        messagebox.showinfo("Modo Demo", f"Ingresaste con el usuario demo: {current_user['nombre']}")
        mostrar_inicio()

    tk.Button(crear_cuerpo, text="Probar Usuario Demo", font=("Helvetica", 9), bg="#E5E5EA", fg="black", bd=0, padx=15, pady=3, command=usar_demo, cursor="hand2").pack(pady=20)

