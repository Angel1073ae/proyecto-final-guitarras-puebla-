def agregar_mi_lista(prod):
    global mi_lista_invitado, current_user
    entrada = {"nombre": prod["nombre"], "precio": prod["precio"]}
    if activar_login and current_user:
        current_user.setdefault("mi_lista", [])
        current_user["mi_lista"].append(entrada)
        messagebox.showinfo("Mi Lista", f"{prod['nombre']} guardado en tus favoritos.")
    else:
        mi_lista_invitado.append(entrada)
        messagebox.showinfo("Mi Lista", f"{prod['nombre']} guardado en tu lista temporal de invitado.")

