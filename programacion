def mostrar_carrito():
    limpiar_cuerpo()
    tk.Label(crear_cuerpo, text="Tu Carrito de Compras", font=("Helvetica", 20, "bold"), bg="white").pack(pady=15)

    total = 0
    if not llenar_carrito:
        tk.Label(crear_cuerpo, text="Tu carrito está vacío. ¡Explora el catálogo!", font=("Helvetica", 12), bg="white", fg="gray").pack(pady=20)
        return

    for i, prod in enumerate(llenar_carrito):
        f = tk.Frame(crear_cuerpo, bg="#F5F5F7", padx=10, pady=5)
        f.pack(fill="x", pady=3, padx=20)
        tk.Label(f, text=f"🛒 {prod['nombre']} — ${prod['precio']:,}", bg="#F5F5F7", font=("Helvetica", 11)).pack(side="left")
        total += prod["precio"]

    tk.Label(crear_cuerpo, text=f"Total a Pagar: ${total:,.2f}", font=("Helvetica", 16, "bold"), bg="white", fg="#FF9500").pack(pady=20)

    def completar():
        if not activar_login or not current_user:
            messagebox.showwarning("Identificación Requerida", "Para proteger tu compra, por favor inicia sesión o regístrate.")
            ejecutar_login()
        else:
            abrir_ventana_pago(total)

    tk.Button(crear_cuerpo, text="Proceder al Pago Seguro", bg="#34C759", fg="white", font=("Helvetica", 12, "bold"), bd=0, padx=30, pady=8, command=completar, cursor="hand2").pack()

def abrir_ventana_pago(total):
    pago_win = tk.Toplevel(crear_ventana)
    pago_win.title("Pasarela de Pago Seguro")
    pago_win.geometry("450x450")
    pago_win.configure(bg="white")

    tk.Label(pago_win, text="Resumen de Pago Seguro", font=("Helvetica", 16, "bold"), bg="white").pack(pady=15)
    tk.Label(pago_win, text=f"Monto Total: ${total:,.2f}", font=("Helvetica", 12, "bold"), fg="#34C759", bg="white").pack(pady=5)

    tk.Label(pago_win, text="Nombre del Titular:", bg="white").pack()
    nombre_recibe = tk.Entry(pago_win, font=("Helvetica", 11), width=35)
    nombre_recibe.pack(pady=3)

    tk.Label(pago_win, text="Número de Tarjeta:", bg="white").pack()
    tarjeta_e = tk.Entry(pago_win, font=("Helvetica", 11), width=35)
    tarjeta_e.pack(pady=3)

    tk.Label(pago_win, text="NIP / Código de Seguridad:", bg="white").pack()
    nip_e = tk.Entry(pago_win, show="*", font=("Helvetica", 11), width=10)
    nip_e.pack(pady=3)

    tk.Label(pago_win, text="Dirección de Envío Completa:", bg="white").pack()
    direccion_e = tk.Entry(pago_win, font=("Helvetica", 11), width=35)
    direccion_e.pack(pady=3)

    def procesar_pago():
        nombre = nombre_recibe.get().strip()
        tarjeta = tarjeta_e.get().strip()
        nip = nip_e.get().strip()
        direccion = direccion_e.get().strip()
        if not (nombre and tarjeta and nip and direccion):
            messagebox.showerror("Error", "Por favor, complete todos los campos de envío y pago.")
            return
        if len(nip) < 3:
            messagebox.showerror("Error", "El código de seguridad (NIP) ingresado no es válido.")
            return
        
        fecha = datetime.now().strftime("%Y-%m-%d %H:%M")
        if activar_login and current_user:
            current_user.setdefault("historial", [])
            for prod in llenar_carrito:
                current_user["historial"].append({"producto": prod["nombre"], "precio": prod["precio"], "fecha": fecha})
            current_user["tarjeta"] = tarjeta

        llenar_carrito.clear()
        messagebox.showinfo("¡Pago Exitoso!", "Tu orden ha sido procesada. Recibirás tus productos muy pronto.")
        pago_win.destroy()
        mostrar_inicio()

    tk.Button(pago_win, text="Confirmar y Pagar", bg="#34C759", fg="white", font=("Helvetica", 12, "bold"), bd=0, padx=20, pady=8, command=procesar_pago, cursor="hand2").pack(pady=20)

def mostrar_configuracion():
    limpiar_cuerpo()
    if activar_login and current_user:
        tk.Label(crear_cuerpo, text="Configuración de Perfil", font=("Helvetica", 18, "bold"), bg="white").pack(pady=15)

        tk.Label(crear_cuerpo, text="Nombre del Cliente:", bg="white").pack()
        nombre_e = tk.Entry(crear_cuerpo, font=("Helvetica", 11), width=30)
        nombre_e.pack(pady=3)
        nombre_e.insert(0, current_user.get("nombre", ""))

        tk.Label(crear_cuerpo, text="Correo Electrónico:", bg="white").pack()
        correo_e = tk.Entry(crear_cuerpo, font=("Helvetica", 11), width=30)
        correo_e.pack(pady=3)
        correo_e.insert(0, current_user.get("correo", ""))

        tk.Label(crear_cuerpo, text="Nueva Contraseña:", bg="white").pack()
        pass_e = tk.Entry(crear_cuerpo, show="*", font=("Helvetica", 11), width=30)
        pass_e.pack(pady=3)
        pass_e.insert(0, current_user.get("contrasena", ""))

        tk.Label(crear_cuerpo, text="Tarjeta Guardada (Opcional):", bg="white").pack()
        tarjeta_e = tk.Entry(crear_cuerpo, font=("Helvetica", 11), width=30)
        tarjeta_e.pack(pady=3)
        tarjeta_e.insert(0, current_user.get("tarjeta", "") or "")

        def guardar_campos():
            nombre = nombre_e.get().strip()
            correo = correo_e.get().strip()
            contra = pass_e.get().strip()
            tarjeta = tarjeta_e.get().strip()
            if not (nombre and correo and contra):
                messagebox.showerror("Error", "Nombre, correo y contraseña son obligatorios")
                return
            for u in usuarios_registrados:
                if u is not current_user and u["correo"] == correo:
                    messagebox.showerror("Error", "Ese correo ya está en uso por otro usuario")
                    return
            current_user["nombre"] = nombre
            current_user["correo"] = correo
            current_user["contrasena"] = contra
            current_user["tarjeta"] = tarjeta
            messagebox.showinfo("Actualizado", "Tus datos de perfil se actualizaron correctamente.")
            mostrar_inicio()

        tk.Button(crear_cuerpo, text="Guardar Cambios", bg="#111111", fg="white", font=("Helvetica", 11, "bold"), bd=0, padx=20, pady=5, command=guardar_campos, cursor="hand2").pack(pady=15)
    else:
        messagebox.showwarning("Acceso Restringido", "Debes iniciar sesión para editar tu información.")
        ejecutar_login()

def mostrar_historial():
    limpiar_cuerpo()
    tk.Label(crear_cuerpo, text="Tu Historial de Pedidos", font=("Helvetica", 20, "bold"), bg="white").pack(pady=15)

    historial = current_user.get("historial", []) if (activar_login and current_user) else usuario_predeterminado.get("historial", [])

    if not historial:
        tk.Label(crear_cuerpo, text="No registras compras previas.", font=("Helvetica", 12), bg="white", fg="gray").pack(pady=20)
        return

    for i, item in enumerate(historial):
        f = tk.Frame(crear_cuerpo, bg="#F5F5F7", padx=10, pady=5)
        f.pack(fill="x", pady=4, padx=20)
        tk.Label(f, text=f"📦 Compra #{i+1} — {item['producto']} — ${item['precio']:,} ({item['fecha']})", bg="#F5F5F7", font=("Helvetica", 11)).pack(side="left")

mostrar_inicio()
crear_ventana.mainloop()
