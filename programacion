    scrollable_frame = tk.Frame(canvas, bg="white")

    scrollable_frame.bind(
        "<Configure>",
        lambda e: canvas.configure(scrollregion=canvas.bbox("all"))
    )
    canvas.create_window((0, 0), window=scrollable_frame, anchor="nw")
    canvas.configure(yscrollcommand=scrollbar.set)

    canvas.pack(side="left", fill="both", expand=True)
    scrollbar.pack(side="right", fill="y")

    productos = definir_productos_func()

    for p in productos:
        frame = tk.Frame(scrollable_frame, bg="#F5F5F7", relief="flat", padx=15, pady=10)
        frame.pack(pady=8, fill="x", padx=10)

        try:
            img = Image.open(os.path.join(ruta_imagenes, p["imagen"]))
            img = img.resize((80, 80))
            img_tk = ImageTk.PhotoImage(img)
            lbl_img = tk.Label(frame, image=img_tk, bg="#F5F5F7")
